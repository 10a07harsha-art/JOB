NODE_ENV=development
HOST=127.0.0.1
PORT=8000
TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_PROVISION_KEY=replace-with-a-separate-long-random-provisioning-key
CORS_ORIGIN=
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=60
VERIFICATION_RATE_LIMIT_MAX=5
GLOBAL_JOBS_URL=
GLOBAL_JOBS_API_KEY=
GLOBAL_TRENDS_URL=
GLOBAL_TRENDS_API_KEY=
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
EMAIL_PROVIDER_URL=
EMAIL_API_KEY=
EMAIL_FROM=no-reply@example.com
PUBLIC_APP_URL=http://127.0.0.1:8000
MONGODB_URI=mongodb+srv://<user>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=careerlink
MONGODB_STORAGE_MODE=single-document
